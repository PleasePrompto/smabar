  "windows": [
    "settings"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-set-size",
    "allow-get-ui-state",
    "allow-get-plugins",
    "allow-get-plugin-ui",
    "allow-list-plugins",
    "allow-remove-plugin",
    "allow-get-shortcuts",
    "allow-list-apps",
    "allow-get-app-icon",
