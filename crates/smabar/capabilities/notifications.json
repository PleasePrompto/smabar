{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "notifications",
  "description": "Plugin popups and shell notices",
  "windows": [
    "notifications"
  ],
  "permissions": [
    "core:default",
    "allow-get-ui-state",
    "allow-plugin-action",
    "allow-get-plugins",
    "allow-get-plugin-ui",
    "allow-get-shortcuts",
    "allow-focus-bar",
    "allow-open-url",
    "allow-ui-log",
    "allow-get-runtime-status",
    "allow-get-surface-context",
    "allow-surface-ready",
    "allow-close-surface",
    "allow-set-notification-measure",
    "allow-stage-notification-update",
    "allow-bar-reply",
    "allow-get-managed-popups",
    "allow-popup-event-report",
    "allow-ensure-google-font"
  ]
}
